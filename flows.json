    {
        "id": "c8314e6b21da4320",
        "type": "function",
        "z": "8db70ae311f732e1",
        "name": "Bộ đếm & Lọc sườn lên",
        "func": "// Khởi tạo các biến nếu chưa có\nlet metalCount = flow.get('metalCount') || 0;\nlet nonMetalCount = flow.get('nonMetalCount') || 0;\nlet totalCount = flow.get('totalCount') || 0;\nlet lastState = context.get('lastState') || false;\n\n// 0. Khởi tạo dữ liệu hiển thị ban đầu (Startup)\nif (msg.topic === \"init\") {\n    return [\n        { payload: metalCount, topic: \"SP Kim loại\" },\n        { payload: nonMetalCount, topic: \"SP Phi kim\" },\n        { payload: totalCount, topic: \"Tổng sản phẩm\" },\n        null\n    ];\n}\n\n// 1. Xử lý nút Reset (đã qua hộp thoại xác nhận)\nif (msg.topic === \"reset\" || msg.payload === \"reset\" || msg.payload === \"Xác nhận đặt lại\") {\n    metalCount = 0;\n    nonMetalCount = 0;\n    totalCount = 0;\n    flow.set('metalCount', 0);\n    flow.set('nonMetalCount', 0);\n    flow.set('totalCount', 0);\n    context.set('lastState', false);\n    return [\n        { payload: 0, topic: \"SP Kim loại\" },         // Out 1: SP Kim loại\n        { payload: 0, topic: \"SP Phi kim\" },          // Out 2: SP Phi kim\n        { payload: 0, topic: \"Tổng sản phẩm\" },       // Out 3: Tổng sản phẩm\n        null                                          // Out 4: Kích hoạt Solenoid\n    ];\n}\n\n// 2. Xử lý nút Giả lập SP Phi kim (Demo)\nif (msg.topic === \"non_metal\" || msg.payload === \"non_metal\") {\n    nonMetalCount += 1;\n    totalCount += 1;\n    flow.set('nonMetalCount', nonMetalCount);\n    flow.set('totalCount', totalCount);\n    return [\n        null,\n        { payload: nonMetalCount, topic: \"SP Phi kim\" },\n        { payload: totalCount, topic: \"Tổng sản phẩm\" },\n        null\n    ];\n}\n\n// 3. Xử lý tín hiệu cảm biến IN1 hoặc nút test kim loại\nlet isMetal = false;\nif (Array.isArray(msg.payload)) {\n    isMetal = Boolean(msg.payload[0]);\n} else if (typeof msg.payload === \"boolean\") {\n    isMetal = msg.payload;\n}\n\n// Phát hiện sườn lên (Rising Edge: false -> true)\nif (isMetal && !lastState) {\n    context.set('lastState', true);\n    metalCount += 1;\n    totalCount += 1;\n    flow.set('metalCount', metalCount);\n    flow.set('totalCount', totalCount);\n    \n    return [\n        { payload: metalCount, topic: \"SP Kim loại\" },\n        null,\n        { payload: totalCount, topic: \"Tổng sản phẩm\" },\n        { payload: [true], topic: \"trigger\" }      // Out 4: Kích hoạt Solenoid\n    ];\n} else if (!isMetal) {\n    context.set('lastState', false);\n}\n\nreturn null;",
