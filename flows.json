    {
        "id": "template_download_csv",
        "type": "ui_template",
        "z": "8db70ae311f732e1",
        "name": "Tự động tải file CSV",
        "group": "dee446f26611a13d",
        "order": 7,
        "width": 0,
        "height": 0,
        "format": "<script>\n(function(scope) {\n    scope.$watch('msg', function(msg) {\n        if (!msg || !msg.payload || typeof msg.payload !== 'string') return;\n        \n        // Ký tự BOM UTF-8 (\\uFEFF) giúp Microsoft Excel hiển thị đúng 100% tiếng Việt\n        var csvWithBom = '\\uFEFF' + msg.payload;\n        var blob = new Blob([csvWithBom], { type: 'text/csv;charset=utf-8;' });\n        var filename = msg.filename || ('Bao_cao_san_luong_' + new Date().toISOString().slice(0, 10) + '.csv');\n        \n        var link = document.createElement('a');\n        if (link.download !== undefined) {\n            var url = URL.createObjectURL(blob);\n            link.setAttribute('href', url);\n            link.setAttribute('download', filename);\n            link.style.visibility = 'hidden';\n            document.body.appendChild(link);\n            link.click();\n            document.body.removeChild(link);\n            window.URL.revokeObjectURL(url);\n        }\n    });\n})(scope);\n</script>",
