    {
        "id": "func_modbus_status",
        "type": "function",
        "z": "8db70ae311f732e1",
        "name": "Xử lý cảnh báo Modbus",
        "func": "// Xử lý trạng thái kết nối Modbus\nlet status = msg.status || {};\nlet fill = status.fill || '';\nlet text = (status.text || '').toLowerCase();\n\n// Hỗ trợ kiểm thử từ nút giả lập trong Tab Bảo trì\nif (msg.topic === 'test_modbus_error') {\n    flow.set('modbusOnline', false);\n    return {\n        payload: {\n            isError: true,\n            title: 'LỖI KẾT NỐI MODBUS',\n            detail: 'Mất kết nối Modbus / Cáp lỏng (Giả lập kiểm thử)'\n        }\n    };\n} else if (msg.topic === 'test_modbus_ok' || msg.topic === 'init') {\n    flow.set('modbusOnline', true);\n    return {\n        payload: {\n            isError: false,\n            title: 'MODBUS RTU: TRUYỀN THÔNG ỔN ĐỊNH',\n            detail: '127.0.0.1:502 (Slave ID: 1)'\n        }\n    };\n}\n\nlet isError = (fill === 'red') || \n              text.includes('error') || \n              text.includes('timeout') || \n              text.includes('disconnected') || \n              text.includes('fail') || \n              text.includes('lỗi');\n\nlet isNormal = (fill === 'green') || (fill === 'yellow') || \n               text.includes('active') || text.includes('reading') || text.includes('connected');\n\nif (isError) {\n    flow.set('modbusOnline', false);\n} else if (isNormal) {\n    flow.set('modbusOnline', true);\n}\n\nlet online = flow.get('modbusOnline');\nif (online === undefined) online = true;\n\nreturn {\n    payload: {\n        isError: !online,\n        title: !online ? 'LỖI KẾT NỐI MODBUS' : 'MODBUS RTU: TRUYỀN THÔNG ỔN ĐỊNH',\n        detail: status.text || (!online ? 'Mất tín hiệu truyền thông / Cáp lỏng / Mất điện' : '127.0.0.1:502 (Slave ID: 1)')\n    }\n};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 380,
        "wires": [
            [
                "template_modbus_alarm"
            ]
        ]
    },
    {
        "id": "template_modbus_alarm",
        "type": "ui_template",
        "z": "8db70ae311f732e1",
        "name": "Cảnh báo kết nối Modbus",
        "group": "dee446f26611a13d",
        "order": 1,
        "width": 6,
        "height": 1,
        "format": "<div class=\"modbus-panel\">\n    <!-- Trạng thái lỗi: Nhấp nháy đỏ cảnh báo công nghiệp -->\n    <div ng-if=\"msg.payload.isError\" class=\"modbus-box error-alert\">\n        <span class=\"alert-icon\">⚠️</span>\n        <div class=\"alert-info\">\n            <div class=\"alert-text\">LỖI KẾT NỐI MODBUS</div>\n            <div class=\"alert-sub\">{{msg.payload.detail || 'Mất kết nối / Cáp lỏng / Mất điện'}}</div>\n        </div>\n    </div>\n\n    <!-- Trạng thái bình thường: Đèn xanh ổn định -->\n    <div ng-if=\"!msg.payload.isError\" class=\"modbus-box normal-status\">\n        <span class=\"status-bulb\"></span>\n        <div class=\"normal-info\">\n            <span class=\"normal-text\">MODBUS RTU: KẾT NỐI ỔN ĐỊNH</span>\n            <span class=\"normal-sub\">Port: 502 | Slave: 1</span>\n        </div>\n    </div>\n</div>\n\n<style>\n.modbus-panel {\n    margin: 4px 0 8px 0;\n    width: 100%;\n}\n.modbus-box {\n    border-radius: 6px;\n    padding: 7px 10px;\n    display: flex;\n    align-items: center;\n    box-sizing: border-box;\n}\n.error-alert {\n    background: rgba(220, 38, 38, 0.28);\n    border: 2px solid #ef4444;\n    color: #ff4d4f;\n    animation: modbusPulse 0.8s infinite alternate ease-in-out;\n}\n.alert-icon {\n    font-size: 20px;\n    margin-right: 8px;\n}\n.alert-info {\n    display: flex;\n    flex-direction: column;\n}\n.alert-text {\n    font-size: 13px;\n    font-weight: 800;\n    color: #ff3333;\n    letter-spacing: 0.5px;\n    text-shadow: 0 0 10px rgba(255, 30, 30, 0.9);\n}\n.alert-sub {\n    font-size: 10px;\n    color: #ffa39e;\n}\n.normal-status {\n    background: rgba(16, 185, 129, 0.12);\n    border: 1px solid rgba(16, 185, 129, 0.35);\n    color: #34d399;\n}\n.status-bulb {\n    width: 9px;\n    height: 9px;\n    background-color: #10b981;\n    border-radius: 50%;\n    margin-right: 8px;\n    box-shadow: 0 0 7px #10b981;\n    display: inline-block;\n}\n.normal-info {\n    display: flex;\n    flex-direction: column;\n}\n.normal-text {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n}\n.normal-sub {\n    font-size: 9px;\n    color: #6ee7b7;\n    opacity: 0.85;\n}\n@keyframes modbusPulse {\n    0% {\n        opacity: 1;\n        background: rgba(220, 38, 38, 0.45);\n        border-color: #ff2222;\n        box-shadow: 0 0 14px rgba(255, 34, 34, 0.8);\n    }\n    100% {\n        opacity: 0.35;\n        background: rgba(220, 38, 38, 0.1);\n        border-color: #991b1b;\n        box-shadow: 0 0 2px rgba(255, 34, 34, 0.15);\n    }\n}\n</style>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
