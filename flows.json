    {
        "id": "func_prep_report",
        "type": "function",
        "z": "8db70ae311f732e1",
        "name": "Thu thập dữ liệu báo cáo",
        "func": "// Thu thập dữ liệu báo cáo thống kê cuối ca\nlet metalCount = flow.get('metalCount') || 0;\nlet nonMetalCount = flow.get('nonMetalCount') || 0;\nlet totalCount = flow.get('totalCount') || 0;\n\nlet now = new Date();\nlet pad = (n) => n < 10 ? '0' + n : n;\nlet dateStr = pad(now.getDate()) + '/' + pad(now.getMonth() + 1) + '/' + now.getFullYear();\nlet timeStr = pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());\n\nlet metalPercent = totalCount > 0 ? ((metalCount / totalCount) * 100).toFixed(1) + '%' : '0%';\nlet nonMetalPercent = totalCount > 0 ? ((nonMetalCount / totalCount) * 100).toFixed(1) + '%' : '0%';\n\nlet filename = 'Bao_cao_san_luong_' + now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate()) + '_' + pad(now.getHours()) + pad(now.getMinutes()) + '.csv';\nmsg.filename = filename;\n\n// Chuẩn bị mảng bản ghi xuất CSV\nmsg.payload = [\n    {\n        \"Ngày báo cáo\": dateStr,\n        \"Thời gian\": timeStr,\n        \"SP Kim loại (chiếc)\": metalCount,\n        \"Tỉ lệ Kim loại\": metalPercent,\n        \"SP Phi kim (chiếc)\": nonMetalCount,\n        \"Tỉ lệ Phi kim\": nonMetalPercent,\n        \"Tổng sản lượng (chiếc)\": totalCount,\n        \"Trạng thái ca\": \"Hoàn tất thống kê\",\n        \"Ghi chú\": \"Hệ thống phân loại sản phẩm SCADA/HMI BTL MMT\"\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 560,
        "wires": [
